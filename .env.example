# Passwordless metadata from `polygres env`; keep native passwords and API keys
# in a server-side secret manager, never in this file.
DATABASE_URL=
DIRECT_URL=
POLYGRES_RUNTIME_URL=

# Production LeRouter Gemma bi-encoder. The URL and deployed run are public
# identity pins; inject the bearer token from a secret manager.
LEROUTER_ROUTING_WORKER_URL=https://promptrail--lerouter-routing-worker-lerouterroutingworker-web.modal.run
LEROUTER_GEMMA4_ROUTER_RUN_ID=gemma4-12b-biencoder-debiased-v2-20260725
PROMPTRAIL_BIENCODEUR_SERVICE_TOKEN=

# Required ModernBERT output-length prediction service. Use the same internal
# bearer token provisioned for LeRouter's authenticated Modal services.
LEROUTER_LENGTH_PREDICTOR_URL=https://buygenius-savings--lerouter-lenght-prediction-output-len-71bcf6.modal.run
LEROUTER_INTERNAL_SERVICE_TOKEN=
