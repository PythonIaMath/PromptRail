# Application URLs and authentication
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
LEROUTER_TRUSTED_ORIGINS=http://localhost:3001
LEROUTER_REQUIRE_EMAIL_VERIFICATION=true

# MongoDB-backed application state
MONGODB_URI=mongodb://127.0.0.1:27017
LEROUTER_MODEL_PROFILE_DB=lerouter
LEROUTER_USER_BUDGET_COLLECTION=user_budget_states
LEROUTER_ROUTE_POLICY_COLLECTION=route_policies
LEROUTER_ROUTE_USAGE_COLLECTION=route_usage_logs
LEROUTER_API_KEY_COLLECTION=api_keys
LEROUTER_CHECKOUT_SESSION_COLLECTION=stripe_checkout_sessions
LEROUTER_SETUP_LINK_COLLECTION=setup_links
LEROUTER_DEVICE_SESSION_COLLECTION=device_sessions
LEROUTER_INSTALLATION_COLLECTION=installations

# Optional analytics
DATAFAST_WEBSITE_ID=
DATAFAST_AI_CRAWL_WEBSITE_ID=

# Email delivery and OAuth
RESEND_API_KEY=
RESEND_FROM=PromptRail <verify@your-domain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PromptRail <verify@your-domain.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# PromptRail routing services. Replace these with the deployed service URLs.
NEXT_PUBLIC_LEROUTER_API_URL=http://localhost:8000
LEROUTER_PUBLIC_BASE_URL=http://localhost:8000
LEROUTER_RETIRED_PUBLIC_BASE_URLS=
LEROUTER_API_URL=http://localhost:8000
LEROUTER_AGENT_TOKEN=replace-with-agent-token
LEROUTER_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-service-token
LEROUTER_INTERNAL_SERVICE_SECRET_NAME=lerouter-internal-service-token
LEROUTER_MODAL_SECRET_NAMES=lerouter-mongodb,together-ai-api-key,openrouter-api-key,anthropic-api-key,lerouter-internal-service-token
LEROUTER_ALLOW_ANONYMOUS_DEV=0
LEROUTER_USE_MODAL_MODELS=1
LEROUTER_ARCHROUTER_URL=https://your-archrouter.modal.run
LEROUTER_E5_ROUTER_URL=https://your-quality-router.modal.run
LEROUTER_ROUTING_WORKER_URL=https://your-routing-worker.modal.run
LEROUTER_LENGTH_PREDICTOR_URL=https://your-length-predictor.modal.run
LEROUTER_WORKFLOW_HORIZON_PREDICTOR_URL=https://your-workflow-horizon-predictor.modal.run
LEROUTER_MODEL_SELECTOR_URL=https://your-model-selector.modal.run/select-models
LEROUTER_ALLOW_DETERMINISTIC_MODEL_SELECTOR_FALLBACK=0
LEROUTER_USER_ID=hermes
LEROUTER_ROUTE_ID=default

# Workflow budget collections
LEROUTER_WORKFLOW_RUN_COLLECTION=workflow_budget_runs
LEROUTER_WORKFLOW_SCOPE_COLLECTION=workflow_budget_scopes
LEROUTER_WORKFLOW_RESERVATION_COLLECTION=workflow_budget_reservations
LEROUTER_WORKFLOW_USAGE_COLLECTION=workflow_route_usage_logs

# Billing and plugin access
STRIPE_SECRET_KEY=sk_test_replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-stripe-webhook-secret
STRIPE_CURRENCY=usd
LEROUTER_PLUGIN_ACCESS_COLLECTION=plugin_access
LEROUTER_PLUGIN_SUBSCRIPTION_MONTHLY_USD=10
LEROUTER_PLUGIN_SUBSCRIPTION_YEARLY_USD=100
LEROUTER_PRODUCT_ENTITLEMENT_COLLECTION=product_entitlements

# Infinite routing control plane
PROMPTRAIL_INFINITE_BETA_OPT_IN_ENABLED=0
PROMPTRAIL_INFINITE_PROVIDER_ALLOWLIST=
PROMPTRAIL_PROVIDER_CREDENTIAL_KEK_V1=replace-with-a-32-byte-base64-key
LEROUTER_INFINITE_RECEIPT_COLLECTION=infinite_execution_receipts

# Blog and SEO automation
LEROUTER_BLOG_POST_COLLECTION=blog_posts
LEROUTER_BLOG_HISTORY_COLLECTION=blog_agent_history
LEROUTER_BLOG_KEYWORD_COLLECTION=blog_keyword_queue
LEROUTER_BRAND_PERSONA_COLLECTION=blog_brand_personas
CRON_SECRET=replace-with-a-random-cron-secret
SEO_ADMIN_SECRET=replace-with-a-random-seo-admin-secret
SEO_BLOG_AUTO_PUBLISH=1
SEO_BLOG_MODEL=gpt-5.6-terra
SEO_BLOG_MIN_WORDS=1400
SEO_BRAND_PERSONA_MAX_AGE_DAYS=30

# Optional provider credentials
TOGETHER_API_KEY=
TOGETHER_AI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
